{
    "name": "Freehand Digitize Dev Env",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff"
            ]
        }
    },
    "remoteEnv": {
        "PYTHONPATH": "${containerWorkspaceFolder}/..:${containerWorkspaceFolder}",
        "QT_QPA_PLATFORM": "offscreen"
    },
    "remoteUser": "root"
}
